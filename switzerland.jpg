<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Yarta | Switzerland</title>

    <link rel="stylesheet" href="style.css">

    <style>

        /* =========================
           HERO
        ========================= */

        .destination-hero {

            min-height: 85vh;

            display: flex;

            align-items: flex-end;

            padding: 100px 8%;

            background:
                linear-gradient(
                    transparent 20%,
                    rgba(5,15,13,.92)
                ),
                url("images/switzerland.jpg");

            background-size: cover;

            background-position: center;

            position: relative;

        }


        .destination-content {

            max-width: 850px;

            animation:
                heroAppear 1s ease;

        }


        .destination-content > span {

            color: #b7f35b;

            font-size: 11px;

            letter-spacing: 3px;

        }


        .destination-content h1 {

            font-size:
                clamp(60px,10vw,120px);

            line-height: .85;

            letter-spacing: -6px;

            margin: 18px 0;

        }


        .destination-content h1 em {

            color: #b7f35b;

            font-weight: normal;

        }


        .destination-content p {

            max-width: 600px;

            color: #c4ceca;

            font-size: 15px;

            line-height: 1.8;

        }


        /* =========================
           INTRO
        ========================= */

        .destination-intro {

            padding: 110px 8%;

            background: #101413;

        }


        .intro-container {

            max-width: 1150px;

            margin: auto;

            display: grid;

            grid-template-columns:
                1.2fr .8fr;

            gap: 80px;

            align-items: center;

        }


        .intro-container h2 {

            font-size:
                clamp(40px,6vw,70px);

            line-height: .95;

            letter-spacing: -4px;

            margin-bottom: 25px;

        }


        .intro-container h2 em {

            color: #b7f35b;

            font-weight: normal;

        }


        .intro-container p {

            color: #899590;

            font-size: 14px;

            line-height: 1.9;

            margin-bottom: 15px;

        }


        .location-card {

            padding: 40px;

            background: #171c1a;

            border: 1px solid #2d3833;

            transition: .4s;

        }


        .location-card:hover {

            transform: translateY(-8px);

            border-color: #b7f35b;

        }


        .location-card span {

            color: #b7f35b;

            font-size: 10px;

            letter-spacing: 2px;

        }


        .location-card h3 {

            font-size: 34px;

            margin: 15px 0;

        }


        .location-card p {

            margin: 0;

        }


        /* =========================
           EXPERIENCES
        ========================= */

        .experiences {

            padding: 110px 8%;

            background: #eaf2ed;

            color: #111b18;

        }


        .section-title {

            max-width: 1150px;

            margin:
                auto auto 50px;

        }


        .section-title span {

            color: #688171;

            font-size: 10px;

            letter-spacing: 3px;

        }


        .section-title h2 {

            font-size:
                clamp(40px,6vw,65px);

            line-height: .95;

            letter-spacing: -4px;

            margin-top: 15px;

        }


        .section-title h2 em {

            color: #7ea73f;

            font-weight: normal;

        }


        /* =========================
           EXPERIENCE CARDS
        ========================= */

        .experience-grid {

            max-width: 1150px;

            margin: auto;

            display: grid;

            grid-template-columns:
                repeat(3,1fr);

            gap: 20px;

        }


        .experience-card {

            min-height: 240px;

            padding: 35px;

            background: #f7faf8;

            border: 1px solid #d2ddd6;

            transition: .4s;

        }


        .experience-card:hover {

            transform:
                translateY(-10px);

            box-shadow:
                0 20px 40px
                rgba(20,40,30,.12);

        }


        .experience-icon {

            font-size: 32px;

            margin-bottom: 25px;

        }


        .experience-card h3 {

            font-size: 22px;

            margin-bottom: 12px;

        }


        .experience-card p {

            color: #69776f;

            font-size: 13px;

            line-height: 1.8;

        }


        /* =========================
           TRAVEL FACTS
        ========================= */

        .travel-facts {

            padding: 110px 8%;

            background: #101413;

        }


        .facts-container {

            max-width: 1150px;

            margin: auto;

        }


        .facts-title span {

            color: #b7f35b;

            font-size: 10px;

            letter-spacing: 3px;

        }


        .facts-title h2 {

            font-size: 55px;

            letter-spacing: -4px;

            margin:
                15px 0 45px;

        }


        .facts-title h2 em {

            color: #b7f35b;

            font-weight: normal;

        }


        .facts-grid {

            display: grid;

            grid-template-columns:
                repeat(4,1fr);

            border:
                1px solid #2c3732;

        }


        .fact {

            padding: 30px;

            border-right:
                1px solid #2c3732;

        }


        .fact:last-child {

            border-right: none;

        }


        .fact span {

            display: block;

            color: #75817b;

            font-size: 9px;

            letter-spacing: 2px;

            margin-bottom: 12px;

        }


        .fact strong {

            color: white;

            font-size: 15px;

        }


        /* =========================
           CTA
        ========================= */

        .destination-cta {

            padding: 120px 7%;

            text-align: center;

            background: #171c1a;

        }


        .destination-cta span {

            color: #b7f35b;

            font-size: 10px;

            letter-spacing: 3px;

        }


        .destination-cta h2 {

            font-size:
                clamp(45px,7vw,80px);

            line-height: .9;

            letter-spacing: -5px;

            margin:
                20px 0 35px;

        }


        .destination-cta h2 em {

            color: #b7f35b;

            font-weight: normal;

        }


        .book-button {

            display: inline-block;

            padding: 16px 28px;

            border-radius: 30px;

            background: #b7f35b;

            color: #101413;

            font-size: 12px;

            font-weight: bold;

            transition: .4s;

        }


        .book-button:hover {

            transform:
                translateY(-5px);

            box-shadow:
                0 15px 35px
                rgba(183,243,91,.2);

        }


        /* =========================
           ANIMATION
        ========================= */

        @keyframes heroAppear {

            from {

                opacity: 0;

                transform:
                    translateY(50px);

            }

            to {

                opacity: 1;

                transform:
                    translateY(0);

            }

        }


        /* =========================
           TABLET
        ========================= */

        @media (max-width: 850px) {

            .intro-container {

                grid-template-columns: 1fr;

                gap: 45px;

            }


            .experience-grid {

                grid-template-columns:
                    1fr 1fr;

            }


            .facts-grid {

                grid-template-columns:
                    1fr 1fr;

            }


            .fact:nth-child(2) {

                border-right: none;

            }

        }


        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 600px) {

            .destination-hero {

                min-height: 75vh;

                padding:
                    100px 7% 70px;

            }


            .destination-content h1 {

                font-size: 65px;

                letter-spacing: -4px;

            }


            .destination-intro {

                padding: 80px 7%;

            }


            .intro-container h2 {

                font-size: 45px;

                letter-spacing: -2px;

            }


            .experiences {

                padding: 80px 7%;

            }


            .experience-grid {

                grid-template-columns: 1fr;

            }


            .travel-facts {

                padding: 80px 7%;

            }


            .facts-title h2 {

                font-size: 45px;

            }


            .facts-grid {

                grid-template-columns: 1fr;

            }


            .fact {

                border-right: none;

                border-bottom:
                    1px solid #2c3732;

            }


            .fact:last-child {

                border-bottom: none;

            }


            .destination-cta {

                padding: 90px 7%;

            }


            .destination-cta h2 {

                font-size: 50px;

                letter-spacing: -3px;

            }

        }

    </style>

</head>


<body>


<!-- =========================
     NAVBAR
========================= -->

<header>

    <nav class="navbar">

        <a href="index.html" class="logo">
            YAR<span>TA</span>
        </a>


        <ul class="nav-menu">

            <li>
                <a href="index.html">
                    Home
                </a>
            </li>

            <li>
                <a href="destinations.html">
                    Places
                </a>
            </li>

            <li>
                <a href="services.html">
                    Services
                </a>
            </li>

            <li>
                <a href="about.html">
                    About
                </a>
            </li>

            <li>
                <a href="contact.html">
                    Contact
                </a>
            </li>

        </ul>


        <a href="contact.html"
           class="nav-contact">

            Let's Travel

        </a>

    </nav>

</header>



<!-- =========================
     HERO
========================= -->

<section class="destination-hero">

    <div class="destination-content">

        <span>
            SWITZERLAND — EUROPE
        </span>

        <h1>
            Hello,
            <em>Switzerland.</em>
        </h1>

        <p>
            Discover breathtaking mountains, peaceful lakes,
            charming villages and unforgettable Alpine scenery.
        </p>

    </div>

</section>



<!-- =========================
     INTRO
========================= -->

<section class="destination-intro">

    <div class="intro-container">

        <div>

            <h2>
                Where nature
                <em>takes center stage.</em>
            </h2>

            <p>
                Switzerland is famous for spectacular
                landscapes, mountain towns and beautiful
                Alpine scenery.
            </p>

            <p>
                Whether you want adventure, relaxation or
                peaceful views, Switzerland offers a wide
                range of experiences for travelers.
            </p>

        </div>


        <div class="location-card">

            <span>
                DESTINATION
            </span>

            <h3>
                Switzerland
            </h3>

            <p>
                A European destination known for mountains,
                lakes, villages and scenic landscapes.
            </p>

        </div>

    </div>

</section>



<!-- =========================
     EXPERIENCES
========================= -->

<section class="experiences">

    <div class="section-title">

        <span>
            01 — EXPERIENCE SWITZERLAND
        </span>

        <h2>
            Adventures
            <em>await.</em>
        </h2>

    </div>


    <div class="experience-grid">


        <article class="experience-card">

            <div class="experience-icon">
                🏔️
            </div>

            <h3>
                Alpine Mountains
            </h3>

            <p>
                Enjoy spectacular mountain landscapes and
                unforgettable views across the Alps.
            </p>

        </article>


        <article class="experience-card">

            <div class="experience-icon">
                🚞
            </div>

            <h3>
                Scenic Railways
            </h3>

            <p>
                Travel through dramatic landscapes on scenic
                railway routes.
            </p>

        </article>


        <article class="experience-card">

            <div class="experience-icon">
                🏞️
            </div>

            <h3>
                Beautiful Lakes
            </h3>

            <p>
                Discover peaceful lakes surrounded by
                mountains and charming towns.
            </p>

        </article>


        <article class="experience-card">

            <div class="experience-icon">
                🥾
            </div>

            <h3>
                Hiking
            </h3>

            <p>
                Explore walking trails and experience
                spectacular natural scenery.
            </p>

        </article>


        <article class="experience-card">

            <div class="experience-icon">
                🏘️
            </div>

            <h3>
                Mountain Villages
            </h3>

            <p>
                Visit charming villages surrounded by
                dramatic Alpine landscapes.
            </p>

        </article>


        <article class="experience-card">

            <div class="experience-icon">
                ❄️
            </div>

            <h3>
                Winter Escape
            </h3>

            <p>
                Experience snowy landscapes and winter
                activities in the mountains.
            </p>

        </article>


    </div>

</section>



<!-- =========================
     TRAVEL FACTS
========================= -->

<section class="travel-facts">

    <div class="facts-container">

        <div class="facts-title">

            <span>
                02 — TRAVEL INFORMATION
            </span>

            <h2>
                Know before
                <em>you go.</em>
            </h2>

        </div>


        <div class="facts-grid">


            <div class="fact">

                <span>
                    DESTINATION
                </span>

                <strong>
                    Switzerland
                </strong>

            </div>


            <div class="fact">

                <span>
                    REGION
                </span>

                <strong>
                    Central Europe
                </strong>

            </div>


            <div class="fact">

                <span>
                    EXPERIENCE
                </span>

                <strong>
                    Nature & Adventure
                </strong>

            </div>


            <div class="fact">

                <span>
                    IDEAL FOR
                </span>

                <strong>
                    Mountains & Relaxation
                </strong>

            </div>


        </div>

    </div>

</section>



<!-- =========================
     CTA
========================= -->

<section class="destination-cta">

    <span>
        READY TO EXPLORE?
    </span>

    <h2>
        Your Switzerland
        <em>story starts here.</em>
    </h2>

    <a href="contact.html"
       class="book-button">

        Plan My Switzerland Trip →

    </a>

</section>



